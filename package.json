{
  "name": "cyl-polen-tracker",
  "version": "1.3.0",
  "description": "Polen level tracker for Castilla y Leon (Spain)",
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "author": "macolmenerori",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/macolmenerori/cyl-polen-tracker"
  },
  "scripts": {
    "dev": "vite-react-ssg dev",
    "build": "tsx scripts/generate-sitemap.ts && tsc --noEmit && vite-react-ssg build",
    "preview": "vite preview",
    "prettify": "prettier -w --log-level=silent src/",
    "lint": "eslint --fix ./src/",
    "test": "jest",
    "types": "tsc --noEmit",
    "verify": "pnpm audit --prod && pnpm lint && pnpm prettify && pnpm types && pnpm test && pnpm build",
    "release": "npx tsx scripts/release.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.3.0",
    "@macolmenerori/component-library": "^1.4.0",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "mapbox-gl": "^3.25.0",
    "react": "^19.2.8",
    "react-cookie-consent": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "swr": "^2.4.2"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.18.1",
    "@eslint/js": "^10.0.1",
    "@jest/types": "^30.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest-dom": "^5.6.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-fixed-jsdom": "^0.0.11",
    "postcss": "^8.5.25",
    "postcss-preset-env": "^11.3.2",
    "prettier": "^3.9.6",
    "react-helmet-async": "^3.0.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.5",
    "vite-react-ssg": "^0.9.0",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
